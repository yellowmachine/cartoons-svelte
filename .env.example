# URL base de tu servidor Jellyfin (sin barra final)
JELLYFIN_URL="http://jellyfin.local:8096"

# Id del usuario de Jellyfin cuya biblioteca y sesiones se usan
JELLYFIN_USER_ID=""

# API key generada en Jellyfin: Panel de administración → API Keys
JELLYFIN_API_KEY=""

# URL pública en la que se sirve esta app (requerido por SvelteKit en producción)
ORIGIN="http://localhost:3000"

# Si se define, la app pide esta contraseña antes de dejar entrar (recomendado
# si es accesible desde internet). Vacío o sin definir = sin contraseña.
ADMIN_PASSWORD=""
