# ─── App (VPS) ──────────────────────────────────────────────────────────────

# URL pública del jellyfin-bridge (el hostname del túnel de Cloudflare), sin
# barra final. En desarrollo con compose.yaml se ignora: usa el bridge local.
JELLYFIN_BRIDGE_URL="https://jellyfin-bridge.example.com"

# Token compartido con el bridge (su API_TOKEN). Genera uno con: openssl rand -hex 32
JELLYFIN_BRIDGE_TOKEN=""

# Service token de Cloudflare Access que protege el bridge (Zero Trust →
# Access → Service Auth). Vacío si el bridge no está detrás de Access.
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""

# URL pública en la que se sirve esta app (requerido por SvelteKit en producción)
ORIGIN="http://localhost:3000"

# Si se define, la app pide esta contraseña antes de dejar entrar (recomendado
# si es accesible desde internet). Vacío o sin definir = sin contraseña.
ADMIN_PASSWORD=""

# ─── jellyfin-bridge (casa) ─────────────────────────────────────────────────
# Solo los lee el bridge; en producción van en el .env de casa, nunca en el VPS.

# URL de Jellyfin vista desde el contenedor del bridge (sin barra final)
JELLYFIN_URL="http://jellyfin.local:8096"

# Id del usuario de Jellyfin cuya biblioteca y sesiones se usan
JELLYFIN_USER_ID=""

# API key generada en Jellyfin: Panel de administración → API Keys
JELLYFIN_API_KEY=""
